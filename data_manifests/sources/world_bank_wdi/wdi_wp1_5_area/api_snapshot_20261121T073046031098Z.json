    "EN.POP.DNST": {
      "field_id": 3,
      "pages": 1,
      "observation_rows": 2926,
      "api_last_updated": "2026-11-11",
      "indicator_name": "Population density (people per sq. km of land area)",
      "unit_metadata": "",
      "source_organization": "FAO population estimates, Food and Agriculture Organization of the United Nations (FAO), publisher: Food and Agriculture Organization of the United Nations (FAO);\nWorld Bank population estimates, World Bank (WB), publisher: World Bank (WB)",
      "source_note": "Population density is midyear population divided by land area in square kilometers. Population is based on the de facto definition of population, which counts all residents regardless of legal status or citizenship--except for refugees not permanently settled in the country of asylum, who are generally considered part of the population of their country of origin. Land area is a country's total area, excluding area under inland water bodies, national claims to continental shelf, and exclusive economic zones. In most cases the definition of inland water bodies includes major rivers and lakes."
    },
    "AG.SRF.TOTL.K2": {
      "field_id": 33,
      "pages": 1,
      "observation_rows": 2926,
      "api_last_updated": "2026-11-11",
      "indicator_name": "Surface area (sq. km)",
      "unit_metadata": "",
      "source_organization": "FAO electronic files and web site, Food and Agriculture Organization of the United Nations (FAO), publisher: Food and Agriculture Organization of the United Nations (FAO)",
      "source_note": "Surface area is a country's total area, including areas under inland bodies of water and some coastal waterways."
    },
    "AG.LND.TOTL.K2": {
      "field_id": 34,
      "pages": 1,
      "observation_rows": 2926,
      "api_last_updated": "2026-11-11",
      "indicator_name": "Land area (sq. km)",
      "unit_metadata": "",
      "source_organization": "FAOSTAT, Food and Agriculture Organization of the United Nations (FAO), uri: https://www.fao.org/faostat/en/#data/RL, publisher: Food and Agriculture Organization of the United Nations (FAO)",
      "source_note": "Land area is a country's total area, excluding area under inland water bodies, national claims to continental shelf, and exclusive economic zones. In most cases the definition of inland water bodies includes major rivers and lakes."
    }
