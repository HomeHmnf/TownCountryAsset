database\">\r\n            <h2 id=\"database_header\" class=\"h2-header en\" title=\"International Comparison Program (ICP) 2005\">International Comparison Program (ICP) 2005</h2>\r\n            <a  data-customlink=\"nl:header\" data-text=\"Metadata for International Comparison Program (ICP) 2005\" href='#dbMetadata' data-toggle='modal' data-target='#dbMetadata'>\r\n                <span title=\"View Metadata\" class=\"rptdbheader sprite icon-info\"></span></a>\r\n        </div>\r\n        \r\n        \r\n        \r\n        <div id=\"upReportLinks\">\r\n\t\r\n                <div class=\"formatListWrapper\">\r\n                    <ul class=\"nav nav-tabs formatList\">\r\n                        <li id=\"liTable\" class=\"active\">\r\n                            <a onclick=\"return onReportClicked(this);\" id=\"lnkTable\" title=\"View as table\" data-customlink=\"nl:header\" data-text=\"Table\" href=\"javascript:__doPostBack(&#39;lnkTable&#39;,&#39;&#39;)\"><span class=\"sprite icon-grid\"></span> Table</a>\r\n                        </li>\r\n                        <li id=\"liChart\" class=\"\">\r\n                            <a onclick=\"return onReportClicked(this);\" id=\"lnkChart\" title=\"View as chart\" data-customlink=\"nl:header\" data-text=\"Chart\" href=\"javascript:__doPostBack(&#39;lnkChart&#39;,&#39;&#39;)\"><span class=\"sprite icon-chart\"></span> Chart</a>\r\n                        </li>\r\n                        <li id=\"liMap\" class=\"\">\r\n                            <a onclick=\"return onReportClicked(this);\" id=\"lnkMap\" title=\"View as map\" data-customlink=\"nl:header\" data-text=\"Map\" href=\"javascript:__doPostBack(&#39;lnkMap&#39;,&#39;&#39;)\"><span class=\"sprite icon-map\"></span> Map</a>\r\n                        </li>\r\n                        <li id=\"liMetadata\" class=\"\">\r\n                            <a onclick=\"return onReportClicked(this);\" id=\"lnkMetadata\" title=\"View metadata\" data-customlink=\"nl:header\" data-text=\"Metadata\" href=\"javascript:__doPostBack(&#39;lnkMetadata&#39;,&#39;&#39;)\"><span class=\"sprite icon-metadata\"></span> Metadata</a>\r\n                        </li>\r\n                        <li class=\"download\"><a href=\"#\" class=\"\" data-toggle=\"\" title=\"Download options\">\r\n                            <span class=\"sprite icon-download\"></span>\r\n                            Download options<span class=\"caret\"></span></a>\r\n                            <ul class=\"dropdown-menu\" id=\"downloadDropdown\">\r\n                                <li id=\"liExcelDownload\"><a data-customlink=\"fd:body content:en:xls\" href=\"#\" data-trackAction='Excel' title=\"Download Excel Format\" onclick=\"return  onDataDownload('excel');\">\r\n                                    Excel</a></li>\r\n                                <li id=\"liCSVDownload\"><a data-customlink=\"fd:body content:en:csv\" href=\"#\" data-trackAction='CSV' title=\"Download CSV Format\" onclick=\"return  onDataDownload('csv');\">\r\n                                    CSV</a></li>\r\n                                <li id=\"liTabDownload\"><a data-customlink=\"fd:body content:en:tab\" href=\"#\" data-trackAction='TabbedTxt' title=\"Download Tabbed Txt Format\" onclick=\"return  onDataDownload('tab');\">\r\n                                    Tabbed TXT</a></li>\r\n                                \r\n                                <li class=\"divider\"></li>\r\n                                <li id=\"liFormattedDownload\"><a data-customlink=\"fd:body content:en:xls\" href=\"#\" data-trackAction='FormattedDownload' onclick=\"return  onFormattedDownload();\">\r\n                                    Data on this page only - formatted</a></li>\r\n                                \r\n                                <li class=\"divider\"></li>\r\n                                <li id=\"liMetadataDownload\"><a data-customlink=\"fd:body content:en:xls\" href=\"#\" data-trackAction='MetaDa