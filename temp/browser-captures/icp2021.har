ionCount element forDimension\" title=\" Classification\"  >\r\n                        16\r\n                    </div>\r\n                </div>\r\n                <div class=\"clearfix\">\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"clearfix\"></div>\r\n\r\n    <div id=\"selectedDimension_Classification\" class=\"panel-collapse collapse selectedDimensionPanel\">\r\n        <div class=\"panel-body\">\r\n            <div class=\"clearfix\">\r\n            </div>\r\n            <div id=\"newSelection_Classification\" class=\"newSelection\">\r\n                <div class=\"dimensionHolder\">\r\n                    <div class=\"dimensionHolderInner\">\r\n                        <div class=\"row\">\r\n                            <div class=\" col-md-12\">\r\n                                <div class=\"variableListWrapper modal-leftCol\">\r\n\r\n\r\n\r\n                                <div class=\"aggregatesFilter\">\r\n\r\n                                    <div class=\"nonclassification\" id=\"showCountryAggOption_Classification\">\r\n                                        <div class=\"btn-group\" data-toggle=\"buttons\" >\r\n                                           \r\n                                            <label class=\"btn showCountryAggOption active\" data-value=\"All\" controlId=\"Classification\">\r\n                                                <input type=\"radio\" name=\"showCountryAggOption\" id=\"showAll_Classification\" checked=\"checked\">\r\n                                                All\r\n                                            </label>\r\n                                            <label class=\"btn showCountryAggOption\" data-value=\"Countries\" controlId=\"Classification\">\r\n                                                <input type=\"radio\" name=\"showCountryAggOption\" id=\"showCountries_Classification\" checked=\"checked\">\r\n                                       