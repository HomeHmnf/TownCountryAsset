Holder\">\r\n                    <div class=\"dimensionHolderInner\">\r\n                        <div class=\"row\">\r\n                            <div class=\" col-md-12\">\r\n                                <div class=\"variableListWrapper modal-leftCol\">\r\n\r\n\r\n\r\n                                <div class=\"aggregatesFilter\">\r\n\r\n                                    <div class=\"nonclassification\" id=\"showCountryAggOption_Classification\">\r\n                                        <div class=\"btn-group\" data-toggle=\"buttons\" >\r\n                                           \r\n                                            <label class=\"btn showCountryAggOption active\" data-value=\"All\" controlId=\"Classification\">\r\n                                                <input type=\"radio\" name=\"showCountryAggOption\" id=\"showAll_Classification\" checked=\"checked\">\r\n                                                All\r\n                                            </label>\r\n                                            <label class=\"btn showCountryAggOption\" data-value=\"Countries\" controlId=\"Classification\">\r\n                                                <input type=\"radio\" name=\"showCountryAggOption\" id=\"showCountries_Classification\" checked=\"checked\">\r\n                                                Countries\r\n                                            </label>\r\n                                            <label class=\"btn showCountryAggOption\" data-value=\"Aggregates\" controlId=\"Classification\">\r\n                                                <input type=\"radio\" name=\"showCountryAggOption\" id=\"showAggregate_Classification\">\r\n                                                Aggregates\r\n                                            </label>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                                   <div class=\"dispNone classification\" id=\"CtryAgg_Classification_Classification\">\r\n                                        <div class=\"btn-group\" data-toggle=\"buttons\">                                           \r\n                                            <label data-customlink=\"sf:body\" data-text=\"Classification Filter - All\" class=\"btn CtryAgg_Classification active\" data-value=\"All\">\r\n                                                <input type=\"radio\" name=\"CtryAgg_Classification\" id=\"Ctry_Classification_Classification\" checked=\"checked\">\r\n                                                All\r\n                                            </label> \r\n                                            <label data-customlink=\"sf:body\" data-text=\"Classification Filter - Countries\" class=\"btn CtryAgg_Classification\" data-value=\"Countries\">\r\n                                                <input type=\"radio\" name=\"CtryAgg_Classification\" id=\"Ctry_Classification_Classification\">\r\n                                                Countries\r\n                                            </label>\r\n                                            <label data-customlink=\"sf:body\" data-text=\"Classification Filter - Aggregates\" class=\"btn CtryAgg_Classification\" data-value=\"Aggregates\">\r\n                                                <input type=\"radio\" name=\"CtryAgg_Classification\" id=\"Agg_Classification_Classification\">\r\n                                                Aggregates\r\n                                            </label>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                                    <div class=\"dispNone classification\" id=\"SubNAtionalButtonGrp\" style=\"display:none\">                                        \r\n                                    </div>\r\n\r\n                                    </div>\r\n\r\n\r\n\r\n                                    <div class=\"clearfix\"></div>\r\n                                    <div class=\"additionalTools\">\r\n                                        <div class=\"availableViewTools\">\r\n                                            <div class=\"pull-left mB5\">\r\n                                                <div class=\"btn-group pull-left\">\r\n                                                    <a data-text=\"Select All Classification\" class=\"btn selectAll btn-default\" title=\"Select all\">\r\n                                                        <span class=\"sprite icon-tick\"></span>\r\n                                                        <span class=\"text\">Select all</span>\r\n                                                    </a>\r\n                                                    <a data-text=\"UnSelect All Classification\" class=\"btn unselectAll btn-default\" title=\"Unselect all\">\r\n                                                        <span class=\"sprite icon-delete\"></span>\r\n                                                        <span class=\"text\">Unselect all</span>\r\n                                                    </a>\r\n                                                    <a data-text=\"Invert Classification\" class=\"btn invertSelection btn-default\" title=\"Invert selection\">\r\n                                                        <span class=\"sprite icon-sort\"></span>\r\n                                                        <span class=\"text\">Invert selection</span>\r\n                                                    </a>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"pull-right mB5\">\r\n                                                <div class=\"filterResults pull-left\" id=\"filterResults_Classification\">\r\n                                                    <a data-customlink=\"