ite icon-login-green'></i>Sign In<span class='caret'></span> </button> <ul class='dropdown-menu'> <li data-customlink=\"nl:header\" style=\"cursor: pointer;\" onclick=\"Javascript:onLangSelectionLoginWBG('en')\">WB Staff Login</li><li data-customlink=\"nl:header\" style=\"cursor: pointer;\" onclick=\"Javascript:onLangSelectionLogin('en')\">Public Login</li></ul> </div>\r\n                </div>\r\n\r\n                 <div class=\"align-welcome pull-right\">\r\n                    <span id=\"lblWelcome\" class=\"welcome-align\" style=\"cursor: default;\"></span>\r\n                    \r\n                    </div>\r\n            </div>\r\n           \r\n            </div>\r\n            <div class=\"clearfix\"></div>\r\n      \r\n       \r\n       </div>\r\n        </div>\r\n        \r\n            <div class=\"language language-sv clearfix\">\r\n                \r\n                    \r\n                    <ul>\r\n                        \r\n                        \r\n                        \r\n                        \r\n                        \r\n                    </ul>\r\n                \r\n            </div>\r\n               \r\n    \r\n    <div class=\"secondaryHeader\">\r\n        <div class=\"dbname\">\r\n            <h2>\r\n                <a data-customlink=\"nl:top navigation\" href=\"/home\" title=\"Go to Databank home page\">\r\n                    DataBank</a></h2>\r\n        </div>         \r\n        <div class=\"database\">\r\n            <h2 id=\"database_header\" class=\"h2-header en\" title=\"ICP 2021\">ICP 2021</h2>\r\n            <a  data-customlink=\"nl:header\" data-text=\"Metadata for ICP 2021\" href='#dbMetadata' data-toggle='modal' data-target='#dbMetadata'>\r\n                <span title=\"View Metadata\" class=\"rptdbheader sprite icon-info\"></span></a>\r\n        </div>\r\n        \r\n        \r\n        \r\n        <div id=\"upReportLinks\">\r\n\t\r\n                <div class=\"formatListWrapper\">\r\n                    <u