# Copy this file to .env and edit values for your machine.
# .env is local configuration and must never be committed.

# Source URLs
TCA_NATURAL_EARTH_URL=https://naturalearth.s3.amazonaws.com/50m_cultural/ne_50m_admin_0_countries.zip
TCA_ISO_REFERENCE_URL=https://raw.githubusercontent.com/stefangabos/world_countries/master/data/countries/en/world.csv
# Official ISO landing page is a manual acquisition/reference point, not a guaranteed direct CSV URL.
TCA_ISO_OFFICIAL_REFERENCE_URL=https://www.iso.org/iso-3166-country-codes.html
TCA_ISO_MANUAL_REFERENCE_CSV=data/reference/iso/iso-3166-1-2026-10.csv
TCA_ISO_MANUAL_REFERENCE_ODS=data/reference/iso/iso-3166-1-2026-10.ods
# Wikidata SPARQL endpoint queried for current Persian (fa) labels; candidates only
TCA_PERSIAN_LABEL_SOURCE_URL=https://query.wikidata.org/sparql
# Flag source: lipis/flag-icons (MIT); refresh records immutable commit and provenance.
TCA_FLAG_SOURCE_URL=https://github.com/lipis/flag-icons
TCA_FLAG_SOURCE_REF=main
# Edge-case evidence URLs are prompts for human review, not automatic approvals.
TCA_FLAG_EVIDENCE_URL_FALKLANDS=https://www.gov.fk/about/
TCA_FLAG_EVIDENCE_URL_SOMALILAND=https://govsomaliland.org/
TCA_FLAG_EVIDENCE_URL_KOSOVO=https://president-ksgov.net/en/legislation/
TCA_FLAG_EVIDENCE_URL_NORTHERN_CYPRUS=https://mfa.gov.ct.tr/
TCA_FLAG_EVIDENCE_URL_INDIAN_OCEAN_TERRITORIES=https://www.gov.uk/world/organisations/british-indian-ocean-territory
TCA_FLAG_EVIDENCE_URL_ASHMORE_CARTIER=https://www.dcceew.gov.au/
TCA_FLAG_EVIDENCE_URL_SIACHEN=https://www.britannica.com/place/Siachen-Glacier

# Local source storage and generated outputs (relative to repository root unless absolute)
TCA_FETCHED_DATA_DIR=raw_data/fetched
TCA_ISO_DATA_DIR=raw_data/iso
TCA_PERSIAN_DATA_DIR=raw_data/persian
TCA_PERSIAN_LOCALIZATION_REPORT=reports/persian-localization-proposals.md
TCA_FLAG_SOURCE_DIR=raw_data/flags
TCA_FLAG_ASSET_OUTPUT_DIR=generated/town_country_asset_candidate/flags
TCA_FLAG_MAPPING=config/country_flag_mapping.json
TCA_FLAG_REPORT=reports/flag-asset-review.md
TCA_FLAG_REVIEW_REPORT=reports/flag-source-review.md
TCA_FLAG_MANUAL_DIR=raw_data/flags/manual
TCA_GAME_DATA_OUTPUT_DIR=generated/town_country_asset_candidate
TCA_APPROVED_DATA_DIR=generated/town_country_asset
TCA_REPORT_DIR=reports/data-refresh
TCA_ISO_PROPOSAL_REPORT=reports/iso-assignment-proposals.md

# Pipeline inputs
TCA_GENERATION_CONFIG=config/generation.json
TCA_REGIONS_CONFIG=config/regions.json
TCA_IDENTITY_REGISTRY=config/country_identity_registry.json

# Pipeline behavior: true/false
TCA_GENERATE_SVGS=true
TCA_COMPARE_WITH_APPROVED=true
TCA_RUN_ISO_REVIEW=true
TCA_RUN_PERSIAN_LOCALIZATION=true
TCA_FLAG_REFRESH_ENABLED=true
TCA_HTTP_TIMEOUT_SECONDS=60
